# Copy to infra/.env and fill in real values. Never commit the real .env file.

PORT=8080
CORS_ORIGINS=https://revasins.com

# LLM provider — "gemini" or "anthropic". Gemini is the default since that's
# the key you're providing; switching providers is just changing these two
# lines, nothing in application code needs to change (see apps/api/src/llm).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=

# Google Sheets — service account scoped to exactly one spreadsheet
# (least privilege — see PLAN.md §8).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Internal staff email alert (SMTP) — fires on every new lead regardless of
# whether the Google Sheets write succeeds.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=info@revasins.com

# Cloudflare Turnstile secret key (server-side verification, paired with the
# site key baked into the widget embed snippet's data-turnstile-site-key).
TURNSTILE_SECRET_KEY=

# Absolute path on the container/VPS filesystem — must be a persistent
# volume, not ephemeral container storage (see docker-compose.yml).
WAL_FILE_PATH=/var/log/riva/leads.jsonl
